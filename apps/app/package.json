{
  "name": "@tie/app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "tie-app Worker: student PWA (static assets) + /api + /m media.",
  "scripts": {
    "dev": "wrangler dev --env local",
    "dev:ai": "wrangler dev",
    "build": "vite build",
    "budgets": "tsx scripts/budgets.ts",
    "check:models": "tsx scripts/checkModels.ts",
    "deploy": "npm run check:models && wrangler deploy",
    "typecheck": "tsc -p tsconfig.json && tsc -p worker/tsconfig.json && tsc -p web/tsconfig.json && tsc -p web/tsconfig.test.json",
    "test": "vitest run --passWithNoTests",
    "db:migrate:local": "wrangler d1 migrations apply tie-db --local"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.1",
    "@preact/signals": "^2.11.3",
    "@tie/shared": "*",
    "@tie/ui": "*",
    "@tie/worker-core": "*",
    "hono": "^4.13.13",
    "idb-keyval": "^6.3.0",
    "preact": "^10.29.8",
    "workbox-background-sync": "^7.4.1",
    "workbox-cacheable-response": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-range-requests": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1",
    "workbox-window": "^7.4.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261007.1",
    "@preact/preset-vite": "^2.10.6",
    "@tie/db": "*",
    "vite": "^8.3.3",
    "vite-plugin-pwa": "^2.0.0",
    "wrangler": "^4.148.0"
  }
}
