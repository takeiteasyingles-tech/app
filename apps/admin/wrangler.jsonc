{
  // tie-admin: admin SPA (Workers Static Assets from dist/web) + /admin-api + /m media. Spec 04 §1.
  // Same D1/R2/AI resources as tie-app; the Worker only runs for /admin-api/* and /m/*.
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "tie-admin",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-09-15",
  "workers_dev": true,
  "dev": { "port": 8788 },
  "assets": {
    "directory": "./dist/web",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/admin-api/*", "/m/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tie-db",
      // Placeholder: the same id as apps/app/wrangler.jsonc (one shared database).
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../packages/db/migrations"
    }
  ],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "tie-media" }],
  "ai": { "binding": "AI" },
  // Namespaces differ from tie-app's (1001-1004) so staff traffic has its own counters.
  "ratelimits": [
    { "name": "RL_AUTH", "namespace_id": "2001", "simple": { "limit": 5, "period": 60 } },
    { "name": "RL_AI", "namespace_id": "2002", "simple": { "limit": 20, "period": 60 } },
    { "name": "RL_API", "namespace_id": "2003", "simple": { "limit": 100, "period": 10 } },
    { "name": "RL_UPLOAD", "namespace_id": "2004", "simple": { "limit": 5, "period": 60 } }
  ],
  "placement": { "mode": "smart" },
  "observability": { "enabled": true },
  // Production values only, as in tie-app: fill both before the first deploy (the admin origin, not
  // tie-app's). COOKIE_PREFIX stays absent (__Host-). Local dev overrides them from .dev.vars
  // (see .dev.vars.example). Secrets as in tie-app.
  "vars": {
    "TURNSTILE_SITEKEY": "",
    "APP_ORIGIN": ""
  },
  "env": {
    // `npm run dev` (wrangler dev --env local): the same bindings WITHOUT the remote-only `ai`, so
    // local dev needs no CLOUDFLARE_API_TOKEN (the AI test screen answers "IA indisponível").
    // `npm run dev:ai` keeps it. Kept in step by tools/parity/test/wrangler.test.ts.
    "local": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "tie-db",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "../../packages/db/migrations"
        }
      ],
      "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "tie-media" }],
      "ratelimits": [
        { "name": "RL_AUTH", "namespace_id": "2001", "simple": { "limit": 5, "period": 60 } },
        { "name": "RL_AI", "namespace_id": "2002", "simple": { "limit": 20, "period": 60 } },
        { "name": "RL_API", "namespace_id": "2003", "simple": { "limit": 100, "period": 10 } },
        { "name": "RL_UPLOAD", "namespace_id": "2004", "simple": { "limit": 5, "period": 60 } }
      ],
      "vars": {
        "TURNSTILE_SITEKEY": "",
        "APP_ORIGIN": ""
      }
    }
  }
}
