{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "tie-app",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:app"],
      "port": 8787
    },
    {
      "name": "tie-admin",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:admin"],
      "port": 8788
    },
    {
      "name": "tie-app-produi",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "wrangler",
        "dev",
        "--config",
        "apps/app/wrangler.jsonc",
        "--env",
        "local",
        "--port",
        "8789",
        "--assets",
        "tools/recovery/out/web/app",
        "--persist-to",
        "apps/app/.wrangler/state"
      ],
      "port": 8789
    },
    {
      "name": "tie-admin-produi",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "wrangler",
        "dev",
        "--config",
        "apps/admin/wrangler.jsonc",
        "--env",
        "local",
        "--port",
        "8790",
        "--assets",
        "tools/recovery/out/web/admin",
        "--persist-to",
        "apps/app/.wrangler/state"
      ],
      "port": 8790
    }
  ]
}
